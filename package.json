{
  "name": "ark-personal-workspace",
  "version": "3.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs --production --lan",
    "start:local": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:sandbox": "node --test tests/sandbox.integration.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "jszip": "^3.10.2",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
